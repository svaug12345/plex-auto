    <string name="accessibility_description">Permet à Démarrage Auto d\'afficher le rappel des tâches à l\'allumage de la TV. Ne lit rien à l\'écran.</string>
    <string name="plex_missing">Impossible d\'ouvrir la cible (Plex introuvable ?)</string>
