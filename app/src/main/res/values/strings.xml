    <string name="btn_update_check">Rechercher une mise à jour</string>
    <string name="btn_update_checking">Recherche en cours…</string>
    <string name="btn_update_install">⬆️ Installer la version %1$s</string>
    <string name="btn_update_progress">Téléchargement… %1$d %%</string>
