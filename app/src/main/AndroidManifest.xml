<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — la "carte d'identité" de l'appli.
    Il déclare : les permissions demandées, les composants (écran, service, récepteur)
    et les événements système auxquels l'appli réagit.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- L'appli est faite pour la TV, mais on ne l'EXIGE pas (sinon impossible à tester ailleurs) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Une TV n'a pas d'écran tactile : on précise qu'on n'en a pas besoin -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Accès à Internet, pour afficher le dashboard famille (v1.1.0) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Être prévenu quand la TV a fini de démarrer (vrai démarrage, pas la sortie de veille) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Faire tourner un "service de premier plan" : un petit processus qui reste vivant
         en permanence pour détecter les sorties de veille. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 impose de déclarer le TYPE de service ; "specialUse" = usage particulier -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- "Afficher par-dessus les autres applis". Depuis Android 10, une appli en arrière-plan
         n'a PAS le droit d'ouvrir une autre appli… sauf si elle a cette permission.
         Sur TV, elle se donne via ADB (voir README). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Depuis Android 11, une appli ne "voit" pas les autres applis installées.
         On déclare donc explicitement qu'on a besoin de voir Plex. -->
    <queries>
        <package android:name="com.plexapp.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- L'écran de réglages, visible dans la liste des applis de la TV -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER = apparaître dans les applis de la TV (Google TV, Projectivy…) -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- LAUNCHER = apparaître aussi sur un téléphone/tablette (pratique pour tester) -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran plein écran du dashboard famille (pas visible dans la liste des applis).
             launchMode singleTask : une seule instance, réutilisée à chaque sortie de veille.
             configChanges : évite de recharger la page si la TV change de résolution/mode HDR. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!-- Écran « Est-ce que les tâches sont faites ? » (v1.2.0).
             excludeFromRecents : il n'apparaît pas dans la liste des applis récentes,
             donc impossible d'y revenir "par la bande" une fois la réponse donnée. -->
        <activity
            android:name=".TaskCheckActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <!-- Récepteur qui se réveille quand la TV démarre, ou quand l'appli vient d'être mise à jour -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Le service qui surveille les sorties de veille et lance Plex -->
        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Justification exigée par Android 14 pour un service "specialUse" -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Lance une appli choisie par l'utilisateur à la sortie de veille de la TV" />
        </service>
    </application>
</manifest>
